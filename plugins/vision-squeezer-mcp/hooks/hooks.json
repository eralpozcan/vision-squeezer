{
  "description": "Hand Claude the token-optimized copy when it reads an image inside the project.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "if": "Read(*.png)",
            "command": "npx -y vision-squeezer@0.8.1 hook"
          },
          {
            "type": "command",
            "if": "Read(*.jpg)",
            "command": "npx -y vision-squeezer@0.8.1 hook"
          },
          {
            "type": "command",
            "if": "Read(*.jpeg)",
            "command": "npx -y vision-squeezer@0.8.1 hook"
          },
          {
            "type": "command",
            "if": "Read(*.webp)",
            "command": "npx -y vision-squeezer@0.8.1 hook"
          },
          {
            "type": "command",
            "if": "Read(*.gif)",
            "command": "npx -y vision-squeezer@0.8.1 hook"
          }
        ]
      }
    ]
  }
}
